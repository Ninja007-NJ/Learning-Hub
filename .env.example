# Server-only Gemini key. Never rename this to VITE_GEMINI_API_KEY.
GEMINI_API_KEY=

# Optional public contact addresses used to open email drafts in the app.
VITE_FEEDBACK_EMAIL=
VITE_TAKEDOWN_EMAIL=

# Local defaults. For a managed host, set HOST=0.0.0.0 and use its assigned PORT.
HOST=127.0.0.1
PORT=5173
